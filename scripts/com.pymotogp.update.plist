<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly PyMotoGP data sync (launchd agent).

  Install:
    cp scripts/com.pymotogp.update.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pymotogp.update.plist
  Remove:
    launchctl bootout gui/$(id -u)/com.pymotogp.update

  Adjust the python path, WorkingDirectory (your PyMotoGP checkout), and log
  paths for your machine. Runs Mondays 09:00; launchd runs a missed job on
  wake, unlike cron.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pymotogp.update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/Caskroom/miniconda/base/bin/python3</string>
        <string>-m</string>
        <string>motogp</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/tejasredkar/Developer/PyMotoGP</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/tejasredkar/.motogp/update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tejasredkar/.motogp/update.log</string>
</dict>
</plist>
